  "cards": [
    {
      "dot": "emerald",
      "title": "Backend call chain",
      "items": [
        "JwtAuthFilter runs first; /api/auth/login and /api/auth/register stay public",
        "Register: anonymous becomes OWNER, an owner token adds only STAFF, staff gets 403",
        "Services resolve CurrentTenant; repos filter owner_id; errors map to {status, message}"
      ]
    },
    {
      "dot": "cyan",
      "title": "Frontend call chain",
      "items": [
        "App boots AuthContext, token lives in localStorage, Layout renders shell + routes",
        "axios interceptor attaches Authorization; /auth/register sends no token; 401 redirects",
        "Pages stay dumb: fetch, render, mutate, refetch"
      ]
    },
    {
      "dot": "rose",
      "title": "Where to change what",
      "items": [
        "New endpoint: controller method plus DTO plus service method",
        "New business rule: service method plus test under src/test/java",
        "New screen: page component plus route line in App.jsx"
      ]
    }
  ]
