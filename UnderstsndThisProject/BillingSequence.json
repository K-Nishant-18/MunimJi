  "cards": [
    {
      "dot": "emerald",
      "title": "Main path",
      "items": [
        "The request clears the JWT filter before any controller code",
        "InvoiceService owns the whole bill in one @Transactional method",
        "The response is a DTO; the JPA entity never leaves the server"
      ]
    },
    {
      "dot": "cyan",
      "title": "Stock safety",
      "items": [
        "FEFO picks batches by earliest expiry with quantity above zero",
        "A shortage throws inside the method and rolls back the bill",
        "@Version columns reject silent concurrent edits"
      ]
    },
    {
      "dot": "orange",
      "title": "After the bill",
      "items": [
        "The UI shows a toast and refetches the invoice list",
        "GET /api/invoices/{id}/pdf re-renders the PDF from stored lines",
        "PDF download uses the same JWT auth as the API"
      ]
    }
  ]
}