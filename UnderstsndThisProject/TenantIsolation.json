  "cards": [
    {
      "dot": "emerald",
      "title": "Who maps to which tenant",
      "items": [
        "Owner resolves to own user id; staff to the owner's id",
        "Anonymous callers reach only /auth/login and /auth/register",
        "Seeded shop: owner@munimji.local owns owner_id = 1"
      ]
    },
    {
      "dot": "cyan",
      "title": "Register rules",
      "items": [
        "Anonymous register creates an OWNER (201 + token)",
        "An owner token may add STAFF only; a second OWNER gets 403",
        "STAFF tokens cannot create users (403)"
      ]
    },
    {
      "dot": "rose",
      "title": "Isolation guarantees",
      "items": [
        "StockBatch and InvoiceItem scope via product and invoice joins",
        "Category names and invoice numbers are unique per shop",
        "data.sql seeds one owner shop; other shops start empty"
      ]
    }
  ]
